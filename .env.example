# Required in production: long random string used to sign sessions and encrypt stored credentials.
APP_SECRET=change-me-to-a-long-random-string

# Optional: enables the Claude AI judge. Without it ProofMyAI runs in "basic" mode (rule-based + neural scorer).
ANTHROPIC_API_KEY=
# Optional: override the judge model (default claude-opus-5).
JUDGE_MODEL=claude-opus-5

# Where the SQLite database lives (use a persistent disk in production).
DATABASE_PATH=./data/agentproof.db

# Protects GET /api/cron (call it every 15 minutes from cron-job.org or crontab).
CRON_SECRET=change-me

# Optional: email alerts via Resend (https://resend.com).
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com

# Public URL of your deployment (used in alert links and setup snippets).
APP_URL=http://localhost:3000

# Set to true only for local/self-hosted use to allow checking bots on localhost/private IPs.
ALLOW_PRIVATE_URLS=false

# Optional: Google Gemini as the AI judge (free tier at https://aistudio.google.com/apikey).
# Used when ANTHROPIC_API_KEY is empty, or always when JUDGE_PROVIDER=gemini.
GEMINI_API_KEY=
# Default gemini-flash-lite-latest (largest free daily quota). Parallel requests default to 1 for free-tier limits.
GEMINI_MODEL=
GEMINI_CONCURRENCY=1
# Optional: force a provider when both keys are set: anthropic | gemini
JUDGE_PROVIDER=

# Where contact-form messages and support links go (use your real inbox, e.g. Gmail).
SUPPORT_EMAIL=contact@usmanabbas.dev
# Optional: Google Search Console "HTML tag" verification code (content value only).
GOOGLE_SITE_VERIFICATION=
# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Not loaded on the dashboard or reset pages.
GA_MEASUREMENT_ID=

# --- Billing with Paddle (optional). Without these, every account is unlimited. ---
# sandbox for testing, production for real payments
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_GROWTH=
PADDLE_PRICE_AGENCY=
# Comma-separated emails with no plan limits (your own account)
UNLIMITED_EMAILS=
# Emails that can open the admin dashboard at /app/admin (defaults to UNLIMITED_EMAILS)
ADMIN_EMAILS=

# --- Trust Center / DPA details ---
# Exact legal name of the operator and country (shown on /security, /dpa, /about, /privacy)
LEGAL_NAME=
LEGAL_COUNTRY=
# Railway region of the app + database, e.g. "EU West (Amsterdam)" (Railway → Settings → Region)
HOSTING_REGION=
# Set to 1 once Google Cloud billing is enabled for the Gemini API key (paid tier: Google does not use prompts to improve products)
GEMINI_PAID_TIER=
# Conversion tracking (sign_up, generate_lead, begin_trial, purchase) via GA4 Measurement Protocol.
# Google Analytics → Admin → Data streams → your stream → Measurement Protocol API secrets → Create.
GA_API_SECRET=
